generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  INITIATOR
  APPROVER
  RECIPIENT
  ADMIN
  AREA_SALES_OFFICER
  CASHIER
  SECURITY_OFFICER
  SERVICE_ADVISOR
  DELIVERY_COORDINATOR
  SPECIAL_APPROVER
}

enum PassType {
  LOCATION_TRANSFER
  CUSTOMER_DELIVERY
  AFTER_SALES
  TEST_DRIVE
}

enum GatePassStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  INITIATOR_OUT
  INITIATOR_IN
  GATE_OUT
  COMPLETED
  CANCELLED
  CASHIER_REVIEW
  DRAFT
}

model User {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  passwordHash     String
  role             Role?
  approverId       String?
  approver         User?          @relation("InitiatorApprover", fields: [approverId], references: [id])
  initiators       User[]         @relation("InitiatorApprover")
  backupApproverId String?
  backupApprover   User?          @relation("InitiatorBackupApprover", fields: [backupApproverId], references: [id])
  backupInitiators User[]         @relation("InitiatorBackupApprover")
  defaultLocation  String?
  brand            String?
  resetToken       String?        @unique
  resetTokenExpiry DateTime?
  isDisabled       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  initiatedPasses  GatePass[]     @relation("InitiatedBy")
  approvedPasses   GatePass[]     @relation("ApprovedBy")
  notifications    Notification[]
  gatePassChanges  GatePassChangeLog[]
  plantMappings    UserPlantMapping[]
  sapReconciliationWrites SapReconciliation[]
}

// Additional plants a user can access data for, on top of their primary `defaultLocation`.
// Plant identity is a plain string (matching `defaultLocation` and the plantPrefix()/startsWith
// convention already used everywhere) — deliberately not a synced master "Plant" catalog.
model UserPlantMapping {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  plantName String
  createdAt DateTime @default(now())

  @@unique([userId, plantName])
}

model GatePass {
  id             String         @id @default(cuid())
  gatePassNumber String         @unique
  passType       PassType       @default(LOCATION_TRANSFER)
  status         GatePassStatus @default(PENDING_APPROVAL)

  vehicle        String
  vehicleColor   String?
  shipmentId     String?
  chassis        String?
  make           String?

  toLocation        String?
  toPlantCode       String?
  toStorageLocation String?
  arrivalDate    String?
  arrivalTime    String?

  vehicleDetails String?
  departureDate  String?
  departureTime  String?

  requestedBy      String?
  requestedByEmail String?
  outReason        String?

  transportMode  String?
  companyName    String?
  carrierName    String?
  carrierRegNo   String?
  driverName     String?
  driverNIC      String?
  driverContact  String?
  driverLicenceNo String? // set only via the post-print "Change Driver" feature; null for passes created before it existed

  mileage        String?
  insurance      String?
  garagePlate    String?
  remarks        String? // user-entered remarks, required on submission for every pass type; shown on the printed gate pass

  // Test Drive fields
  returnDate      String?   // scheduled return date (locked = departureDate)
  returnTime      String?   // scheduled return time (max departureTime + 1hr)
  returnMileage   String?
  customerName    String?
  customerNIC     String?
  customerContact String?
  reminderSentAt  DateTime? // set once the overdue reminder email has been sent (send-once)
  comments        String?
  rejectionReason String?
  resubmitCount   Int     @default(0)
  resubmitNote    String? // initiator's correction note when resubmitting
  intendedApprover     String? // approver name selected by initiator at creation / after reassign
  previousApprover     String? // original approver name when initiator redirected the pass
  approverChangeReason String? // reason given by initiator for changing the approver

  passSubType    String?   // MAIN_IN | MAIN_OUT | SUB_OUT | SUB_IN
  paymentType    String?   // CASH | CREDIT | MIXED (used for MAIN_OUT)
  cashierCleared           Boolean  @default(false)
  creditApproved           Boolean  @default(false)
  creditRejected           Boolean  @default(false)
  hasCredit                Boolean  @default(false)
  hasImmediate             Boolean  @default(false)
  cashierOverrideRequested      Boolean  @default(false)
  singleOrderEscalated          Boolean  @default(false)
  singleOrderEscalatedApproverId String?  // user ID of approver selected by cashier for single-order escalation
  escalationApproved            Boolean  @default(false) // approver signed off escalated orders; cashier can now generate invoice
  escalationRejectionReason     String?  // set when approver rejects single-order sign-off; cleared on resubmit
  serviceJobNo      String?   // After Sales service job/work order number
  securityCreated   Boolean  @default(false) // created by Security Officer with vehicle only
  gateDirection     String?  // "IN" | "OUT" — direction selected by security at creation
  parentPassId      String?
  parentPass     GatePass?  @relation("SubPasses", fields: [parentPassId], references: [id])
  subPasses      GatePass[] @relation("SubPasses")
  returnPassLocked Boolean  @default(false) // LT Return Gate Pass: locked until the original (parent) pass completes
  fromLocation        String?
  fromPlantCode       String?
  fromStorageLocation String?
  sapVehicleId        String?
  asoCreated          Boolean  @default(false)
  gateOutBy           String? // name of user who performed gate out (SO / ASO / Initiator)
  gateInBy            String? // name of user who confirmed gate in (SO / ASO / Initiator / Recipient)

  createdById    String
  createdBy      User           @relation("InitiatedBy", fields: [createdById], references: [id])

  approvedById   String?
  approvedBy     User?          @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?

  notifications  Notification[]
  serviceOrders  ServiceOrder[]
  changeLogs     GatePassChangeLog[]
  sapReconciliation SapReconciliation?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ServiceOrder {
  id              String   @id @default(cuid())
  gatePassId      String
  gatePass        GatePass @relation(fields: [gatePassId], references: [id])
  orderId         String
  orderStatus     String            // bezei — human-readable status (e.g. "Closed")
  orderStatusCode String   @default("")  // hstat  (e.g. "H070")
  billingType     String   @default("")  // fkart  (e.g. "ZSF2", "ZVVO")
  payTermCode     String   @default("")  // zterm  (e.g. "ZC01")
  payTerm         String   @default("")  // paymenttermsname (e.g. "Payment Immediate")
  cancelled       Boolean  @default(false) // fksto
  isHappyPath     Boolean  @default(false) // hstat=H070 && (fkart=ZSF2||ZVVO) && zterm=ZC01 && !cancelled
  isAssigned      Boolean  @default(false) // cashier marked as paid
  createdAt       DateTime @default(now())
}

model LocationOption {
  id                 String   @id @default(cuid())
  plantCode          String
  plantDescription   String
  storageLocation    String
  storageDescription String
  locationType       String?  // DEALER | DIMO | PROMOTION | FINANCE
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([plantCode, storageLocation])
}

model LocationLabel {
  id              String   @id @default(cuid())
  plantCode       String
  storageLocation String
  label           String
  createdAt       DateTime @default(now())

  @@unique([plantCode, storageLocation, label])
}

model RequestedByOption {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OutReasonOption {
  id        String   @id @default(cuid())
  value     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BrandOption {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VehicleOption {
  id           String   @id @default(cuid())
  vehicleNo    String   @unique
  chassisNo    String?
  description  String?
  model        String?
  make         String?
  colourFamily String?
  colour       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DriverOption {
  id        String   @id @default(cuid())
  name      String
  nic       String   @unique
  licenceNo String?  @unique // Driving Licence No. — nullable only for legacy rows created before this field existed; required for every new driver
  contact   String?
  carrierId String?
  carrier   CarrierOption? @relation(fields: [carrierId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CarrierOption {
  id             String   @id @default(cuid())
  companyName    String
  registrationNo String   @unique
  drivers        DriverOption[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Audit trail for the post-print "Change Driver" feature (and any future post-approval field changes).
model GatePassChangeLog {
  id          String   @id @default(cuid())
  gatePassId  String
  gatePass    GatePass @relation(fields: [gatePassId], references: [id])
  changeType  String   // e.g. "DRIVER_UPDATE"
  previousData Json
  newData     Json
  reason      String?
  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id])
  createdAt   DateTime @default(now())
}

model LocationBrandMapping {
  id            String   @id @default(cuid())
  location      String
  brand         String
  initiatorName String
  approverName  String
  createdAt     DateTime @default(now())

  @@unique([location, brand])
}

// Admin-configurable status codes controlling which vehicles appear in the Location
// Transfer vehicle dropdown. "QV*"/"VMM*"/"VMS*" are catch-all rows — see lib/lt-status-config.ts.
model LtVehicleStatusOption {
  id        String   @id @default(cuid())
  code      String   @unique
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// Location Transfer passes that completed without an SAP write (vehicle wasn't eligible
// per the MMSTA=QP60 / SDSTA blank-or-QS20 rule at the time). Tracked here so Admin can
// later re-check SAP and manually write the vehicle once it becomes eligible. One row per
// GatePass — created only going forward from when this feature shipped (no backfill of
// older completed passes, since there's no reliable record of their SAP-write outcome).
model SapReconciliation {
  id            String    @id @default(cuid())
  gatePassId    String    @unique
  gatePass      GatePass  @relation(fields: [gatePassId], references: [id])
  ltCompletedAt DateTime
  mmstaAtCompletion String
  sdstaAtCompletion String
  latestMmsta   String?
  latestSdsta   String?
  eligibility   String    @default("PENDING") // PENDING | READY | WRITTEN | FAILED
  lastCheckedAt DateTime?
  writtenAt     DateTime?
  writtenById   String?
  writtenBy     User?     @relation(fields: [writtenById], references: [id])
  notifiedAt    DateTime? // Initiator "now eligible" notification — sent once
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  auditLogs     SapReconciliationAuditLog[]
}

// Full history of every reconciliation check and SAP write attempt for a pending vehicle —
// kept because SAP writes here are manually triggered later, sometimes long after the
// original Location Transfer completed.
model SapReconciliationAuditLog {
  id               String   @id @default(cuid())
  reconciliationId String
  reconciliation   SapReconciliation @relation(fields: [reconciliationId], references: [id])
  gatePassId       String
  action           String   // CHECK | WRITE_ATTEMPT
  mode             String   // AUTO | MANUAL | INDIVIDUAL | BULK
  triggeredById    String?  // null when performed by the system (daily job)
  triggeredByName  String
  mmstaAtCheck     String?
  sdstaAtCheck     String?
  success          Boolean?
  responseMessage  String?
  createdAt        DateTime @default(now())
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  type       String
  title      String
  message    String
  gatePassId String?
  gatePass   GatePass? @relation(fields: [gatePassId], references: [id])
  read       Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

// Admin-managed recipient list for the "Customer Delivery Completed" email notification
// (sent after Initiator Print or Security Gate Out completes a Customer Delivery pass).
// Not tied to any User account — recipients are picked from Active Directory via
// /api/ad-users and stored here purely as name+email.
model CdNotificationRecipient {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
}
